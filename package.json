{
  "name": "obsidian-pptx-studio",
  "version": "0.3.0",
  "description": "Open, edit and inspect PowerPoint (.pptx) decks natively: a PowerPoint-style editing surface, an OOXML property inspector, slide embeds, Markdown extraction and PNG export.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "test": "node esbuild.tests.mjs && node --test \"tests/.build/*.test.cjs\"",
    "smoke": "node esbuild.smoke.mjs && node scripts/smoke.cjs",
    "fixture": "node scripts/make-fixture.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "pptx",
    "powerpoint",
    "ooxml"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.1.2",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
